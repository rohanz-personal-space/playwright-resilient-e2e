{
  "name": "playwright-resilient-e2e",
  "version": "1.0.0",
  "description": "A production-grade Playwright TypeScript framework for reliable E2E testing and failure diagnostics.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api",
    "test:resilience": "playwright test tests/resilience --project=chromium",
    "test:a11y": "playwright test tests/accessibility --project=chromium",
    "test:visual": "playwright test tests/visual --project=chromium",
    "test:update-snapshots": "playwright test tests/visual --project=chromium --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "qa",
    "page-object-model",
    "ci"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  }
}
